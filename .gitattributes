# Normalise line endings to LF, in the repository and in the working tree.
#
# This repo was authored on Windows but builds and runs on Linux (WSL2 locally,
# rented GPU boxes remotely). CRLF reaching a shell script, a Makefile or gcc
# produces failures that are tedious to diagnose because the file looks correct
# in every editor.
#
# `text=auto` lets git detect which files are text; `eol=lf` pins the working
# tree to LF on every platform, including Windows.
* text=auto eol=lf

# Never touch these — byte-for-byte or the hashes in data/manifest.json break.
*.zip   binary
*.jar   binary
*.class binary
*.so    binary
*.dll   binary
*.exe   binary
*.pyc   binary
*.pdf   binary
*.png   binary
*.docx  binary
