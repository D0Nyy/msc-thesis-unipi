# Copy to .env and fill in. Never commit .env.
# python-dotenv takes values literally — do NOT quote or escape the backslashes.

# --- Models ---------------------------------------------------------------
# Tier A (flagship API)
ANTHROPIC_API_KEY=
# Tiers S / M / L — Ollama, OpenAI-compatible endpoint
OLLAMA_HOST=http://localhost:11434
OLLAMA_CLOUD_HOST=

# --- Toolchain (Windows paths) --------------------------------------------
# C/C++ -> F2
GHIDRA_INSTALL_DIR=C:\ghidra
GHIDRA_PROJECT_DIR=C:\ghidra_projects
# Java -> F1
VINEFLOWER_JAR=C:\tools\vineflower.jar
# C# -> F1
ILSPYCMD_PATH=ilspycmd
# Python -> F1 (.pyc), qualitative track
PYCDC_EXE=C:\tools\pycdc.exe

# --- Run layout -----------------------------------------------------------
VULNLM_DATA_DIR=data
VULNLM_RESULTS_DIR=results
